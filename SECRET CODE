
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int i;
    char code[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

    srand(time(0));

    printf("================================\n");
    printf("       SECRET CODE GENERATOR\n");
    printf("================================\n");

    printf("Your unique secret code is: ");

    for (i = 0; i < 10; i++) {
        printf("%c", code[rand() % 36]);
    }

    printf("\n================================\n");
    printf("     Code generated successfully!\n");

    return 0;
}
